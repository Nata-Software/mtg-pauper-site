// MTG Pauper stats — schema
// Data comes from two Google Sheet tabs exported as CSV: Ranking + Rounds.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// One row per player per match (mirrored: each match stored twice, once per side).
// Source: Rounds CSV.
model Match {
  id             Int      @id @default(autoincrement())
  store          String   @default("default")
  eventName      String
  date           DateTime?
  round          Int
  player         String
  deck           String
  playerScore    Int
  result         String // "win" | "loss" | "draw"
  opponent       String
  opponentDeck   String
  opponentScore  Int
  tournamentId   String? // melee tournament id (null for CSV-imported history)
  tournamentName String?
  // Card-based archetype (denormalized from Decklist for simple queries).
  // Null for legacy CSV data with no decklist -> views fall back to `deck`.
  decklistId         String?
  opponentDecklistId String?
  archetype          String?
  opponentArchetype  String?
  createdAt      DateTime @default(now())

  @@index([store, deck, opponentDeck])
  @@index([store, date])
  @@index([store, tournamentId])
  @@index([store, archetype, opponentArchetype])
}

// One scraped decklist with its actual cards. The cards are the source of
// truth: re-classifying (changing the rules) re-runs over these, no re-scrape.
model Decklist {
  id           String   @id // melee DecklistId (GUID)
  tournamentId String?
  player       String
  rawName      String // player-typed deck name
  archetype    String // card-based classification
  cards        Json // [{ qty, slug, name }]
  createdAt    DateTime @default(now())

  @@index([tournamentId])
}

// Fixed-window rate limiting for admin endpoints, keyed by "action:ip".
// DB-backed so it holds across serverless instances (in-memory would not).
model RateLimit {
  id          String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

// One row per player per event (standings). Source: Ranking CSV.
model Standing {
  id             Int      @id @default(autoincrement())
  store          String   @default("default")
  eventName      String
  date           DateTime?
  nickname       String
  fullName       String
  points         Int
  position       Int
  deck           String
  archetype      String?
  tournamentId   String?
  tournamentName String?
  createdAt      DateTime @default(now())

  @@index([store, eventName])
  @@index([store, date])
  @@index([store, tournamentId])
}

// ── Mont Pauper League (MPL) ─────────────────────────────────────────────────
// The yearly league — entirely separate from the weekly matchup data above.
// These tables are never joined to Match/Standing and never surface in the
// matchup/standings/metagame pages. Data source: melee Opens standings (scraped)
// + the store's "classified players" sheet. See src/lib/mpl/.

// One MPL Open (monthly stage). Points come straight from the melee standings.
model MplStage {
  id               Int         @id @default(autoincrement())
  season           Int // e.g. 2026
  kind             String      @default("open")
  ordinal          Int // 1..N within the season
  name             String // melee tournament name
  date             DateTime?
  meleeId          String? // melee Tournament/View id — lets us re-scrape/refresh
  format           String      @default("individual") // "individual" | "trios"
  countsForRanking Boolean     @default(true) // trios/team events are excluded from the points ranking
  playerCount      Int?
  results          MplResult[]
  createdAt        DateTime    @default(now())

  @@unique([season, kind, ordinal])
  @@index([season])
}

// One player's finish in one Open. Aggregated across Opens by `username` —
// melee's per-tournament player `ID` is NOT stable (a new id per registration),
// but the account `username` is, so it's the identity key.
model MplResult {
  id       Int      @id @default(autoincrement())
  stageId  Int
  stage    MplStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  username String // stable melee account handle (lowercased) — aggregation key
  player   String // melee display name at scrape time
  rank     Int
  record   String? // melee "W-L-D"
  points   Int
  omw      Float?
  tgw      Float?
  ogw      Float?

  @@index([stageId])
  @@index([username])
}

// A confirmed Final spot (the "classified players" master list). Sources span
// Opens, Mont weeklies, and partner stores. `meleeUsername` bridges a spot to
// its Opens identity when known (resolved at seed time via the alias map), so
// the ranking can tell who already holds a spot.
model MplSpot {
  id            Int       @id @default(autoincrement())
  season        Int
  ordinal       Int // row # in the sheet
  player        String // real name from the sheet
  meleeUsername String? // bridge to the Opens `username`, when determinable
  source        String // e.g. "1º Open MPL - Mont", "Arcade - Vaga 1"
  sourceType    String // "open" | "parallel_mont" | "partner_store" | "last_chance"
  store         String?
  date          DateTime?
  standingsRef  String?
  mural         String?
  createdAt     DateTime  @default(now())

  @@index([season])
  @@index([meleeUsername])
}
